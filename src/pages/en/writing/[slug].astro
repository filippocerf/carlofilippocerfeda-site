---
import Base from '../../../layouts/Base.astro';
import ArticleWriting from '../../../components/views/ArticleWriting.astro';
import { getWriting, baseSlug } from '../../../utils';

export async function getStaticPaths() {
  const entries = await getWriting('en');
  return entries.map((entry) => ({
    params: { slug: baseSlug(entry.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base lang="en" current="writing" title={entry.data.title} description={entry.data.description}>
  <ArticleWriting entry={entry} lang="en">
    <Content />
  </ArticleWriting>
</Base>
