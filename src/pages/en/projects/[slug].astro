---
import Base from '../../../layouts/Base.astro';
import ArticleProject from '../../../components/views/ArticleProject.astro';
import { getProjects, baseSlug } from '../../../utils';

export async function getStaticPaths() {
  const entries = await getProjects('en');
  return entries.map((entry) => ({
    params: { slug: baseSlug(entry.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base lang="en" current="projects" title={entry.data.title} description={entry.data.description}>
  <ArticleProject entry={entry} lang="en">
    <Content />
  </ArticleProject>
</Base>
