---
import Base from '../../layouts/Base.astro';
import ArticleWriting from '../../components/views/ArticleWriting.astro';
import { getWriting, baseSlug } from '../../utils';

export async function getStaticPaths() {
  const entries = await getWriting('it');
  return entries.map((entry) => ({
    params: { slug: baseSlug(entry.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base lang="it" current="writing" title={entry.data.title} description={entry.data.description}>
  <ArticleWriting entry={entry} lang="it">
    <Content />
  </ArticleWriting>
</Base>
