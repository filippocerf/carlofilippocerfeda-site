---
import { t, localePath } from '../../i18n/ui';
import { formatDate, type ProjectEntry } from '../../utils';
import type { Lang } from '../../site.config';

interface Props {
  entry: ProjectEntry;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const tr = t(lang);
---

<a class="back-link" href={localePath(lang, 'projects')}>← {tr('backTo.projects')}</a>

<article>
  <header class="article-header">
    <div class="card-meta">
      {entry.data.stack.map((s) => <span class="badge">{s}</span>)}
    </div>
    <h1>{entry.data.title}</h1>
    <p class="muted" style="font-size:1.1rem; margin-top:0.4rem;">{entry.data.description}</p>
    {
      (entry.data.repoUrl || entry.data.liveUrl) && (
        <div class="project-links">
          {entry.data.liveUrl && (
            <a class="btn btn-primary" href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer">
              {tr('projects.live')} →
            </a>
          )}
          {entry.data.repoUrl && (
            <a class="btn" href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer">
              {tr('projects.repo')}
            </a>
          )}
        </div>
      )
    }
  </header>

  <div class="prose">
    <slot />
  </div>
</article>
