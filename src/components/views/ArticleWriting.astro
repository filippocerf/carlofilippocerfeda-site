---
import { t, localePath } from '../../i18n/ui';
import { formatDate, type WritingEntry } from '../../utils';
import type { Lang } from '../../site.config';

interface Props {
  entry: WritingEntry;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const tr = t(lang);
const typeLabel = entry.data.type === 'commentary' ? tr('type.commentary') : tr('type.thought');
---

<a class="back-link" href={localePath(lang, 'writing')}>← {tr('backTo.writing')}</a>

<article>
  <header class="article-header">
    <div class="card-meta">
      <span class="badge badge-accent">{typeLabel}</span>
      <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, lang)}</time>
    </div>
    <h1>{entry.data.title}</h1>
    {
      entry.data.type === 'commentary' && entry.data.sourceUrl && (
        <p class="source-note">
          {tr('commentary.on')}:{' '}
          <a href={entry.data.sourceUrl} rel="noopener noreferrer" target="_blank">
            {entry.data.sourceTitle ?? entry.data.sourceUrl}
          </a>
        </p>
      )
    }
    {
      entry.data.tags.length > 0 && (
        <div class="tag-row">
          {entry.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </header>

  <div class="prose">
    <slot />
  </div>
</article>
